<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up: the identity key is sealed by this device's Keystore
     and can't be decrypted anywhere else, and history is private. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
